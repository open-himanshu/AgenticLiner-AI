# AgenticLiner Environment Configuration Template
APP_ENV=development
APP_PORT=8000
DEBUG=True

# Database Settings
DATABASE_PATH=agenticliner.db

# Authentication & Sessions
SECRET_KEY=change_me_to_a_secure_random_string_in_production
SESSION_COOKIE_NAME=agenticliner_session
SESSION_MAX_AGE=86400

# LLM Keys
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
