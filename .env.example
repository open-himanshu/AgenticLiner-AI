# AgenticLiner Environment Configuration Template
# Duplicate this file to .env and fill in your keys

# LLM Keys
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=your_groq_api_key_here

# Database Settings
DATABASE_URL=sqlite:///./agenticliner.db

# App Settings
APP_ENV=development
APP_PORT=8000
DEBUG=True

# Email & Outbox (Demo Test Settings)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=test_sender@example.com
SMTP_PASS=app_password_here
DEMO_TEST_EMAIL=team_notifications@example.com
